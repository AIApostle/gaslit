# ==============================================================================
# Gaslit Backend Environment Variables (Render & Local Production)
# ==============================================================================
# Add these variables in your Render Dashboard:
# Service -> "Environment" tab -> "Add Environment Variable"
# ==============================================================================

# Database: Neon Serverless PostgreSQL (Recommended for production persistence)
# Format: postgresql+asyncpg://<user>:<password>@<ep-xxxx-pooler>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-xxxx-pooler.neon.tech/neondb?sslmode=require

# SwiftAgents In-Browser AI Intake Engine
SWIFTAGENTS_COMPANY_ID=your_company_id_here
SWIFTAGENTS_PUBLIC_KEY=swa_live_your_public_key_here

# Staff Admin API Secret (Used by the /admin triage desk)
STAFF_API_KEY=your_staff_api_key_here

# Optional: Shared secret for server-to-server tool calling (leave blank if not needed)
SWIFTAGENTS_AGENT_KEY=

# Optional: Webhook URL for outbound notification events
SWIFTAGENTS_WEBHOOK_URL=https://gaslit.onrender.com/v1/agent/webhook
